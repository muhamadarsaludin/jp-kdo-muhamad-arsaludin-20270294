# ===== Aplikasi =====
APP_PORT=8090
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# ===== Database (dipakai backend & docker compose) =====
# Port host 5435 dipakai agar tidak bentrok dengan PostgreSQL lain di mesin ini.
POSTGRES_USER=kdo
POSTGRES_PASSWORD=kdo
POSTGRES_DB=kdo
POSTGRES_PORT=5435
DATABASE_URL=postgres://kdo:kdo@localhost:5435/kdo?sslmode=disable

# ===== Auth =====
JWT_SECRET=ganti-di-produksi-minimal-32-karakter
JWT_EXPIRED_HOURS=12

# ===== Seed =====
SEED_ON_START=true
